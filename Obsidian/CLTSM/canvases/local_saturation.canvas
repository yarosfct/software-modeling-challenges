		{"id":"title","type":"text","text":"Local saturation of the category set\nNot global theoretical saturation","x":-400,"y":-360,"width":520,"height":80,"color":"4"},
		{"id":"scope","type":"text","text":"Why not global\n\nMostly Portuguese HE students (IST/ISEL + earlier cases). Wave 1 also: 2 Wrocław (S4 S5), 1 Munich (S6). Wave 2: no new lecturers, no new countries. Coordinators: further recruitment unrealistic.","x":500,"y":240,"width":400,"height":200,"color":"3"},
