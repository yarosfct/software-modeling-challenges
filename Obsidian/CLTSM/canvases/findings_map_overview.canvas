		{"id":"ph4","type":"text","text":"PH4 — A diagram survives only if someone owns it and someone reads it [finding]\nGroup ownership and a real audience decide whether modelling stays alive and careful.","x":1520,"y":1390,"width":380,"height":140,"color":"6"},
		{"id":"oq4","type":"text","text":"Open: densify CAT14 beyond S6?","x":2260,"y":1430,"width":280,"height":60,"color":"1"},
