		{"id":"comp_tools","type":"file","file":"qualitative_analysis/04_cross_case_analysis/comparison_tools_progressive_guidance.md","x":0,"y":535,"width":330,"height":65},
		{"id":"conditions","type":"text","text":"## Conditions\n\nAssessment and course architecture + social/contextual conditions shape what support is accessible and what response feels feasible.","x":460,"y":-1090,"width":340,"height":150},
		{"id":"response_matrix","type":"file","file":"qualitative_analysis/04_cross_case_analysis/response_mode_matrix.md","x":-1600,"y":-212,"width":360,"height":90},
		{"id":"cases","type":"text","text":"## Empirical base\n\nRaw transcripts and first-cycle coding remain preserved. The canvas summarizes the cross-case interpretation, not a replacement for source evidence.","x":-1600,"y":110,"width":360,"height":130},
		{"id":"student_transcripts","type":"text","text":"Student cases\n\nS1-S6","x":-1340,"y":375,"width":170,"height":80},
